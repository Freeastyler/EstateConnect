rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }
    
    // Check if current user is admin
    function isAdmin() {
      return isAuth() && 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    
    // Users collection rules
    match /users/{userId} {
      allow read: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuth();
      allow update: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }
    
    // Bookings collection rules
    match /bookings/{bookingId} {
      allow read: if isAuth() && (resource.data.residentId == request.auth.uid || isAdmin());
      allow create: if isAuth() && (request.resource.data.residentId == request.auth.uid || isAdmin());
      allow update: if isAuth() && (resource.data.residentId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }
    
    // Providers collection rules
    match /providers/{providerId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
    
    // Messages collection rules
    match /messages/{messageId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuth();
      allow update: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }
  }
}
